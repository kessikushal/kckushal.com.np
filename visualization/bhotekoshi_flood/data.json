{
  "app": {
    "title": "Bhote Koshi Flood Analysis",
    "logo": "image/APN.png",
    "apiKey": "beLTXJmGL8weKgdDngiU",
    "center": [85.35, 28.15],
    "zoom": 6,
    "pitch": 45,
    "terrain": false,
    "defaultBasemap": "DARK",
    "fitLayer": "flood-area",
    "fitPadding": 25,
    "fitMaxZoom": 15,
    "sidebarOpen": true
