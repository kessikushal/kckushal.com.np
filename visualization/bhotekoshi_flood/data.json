  "basemaps": [
    { "id": "DARK", "label": "Dark Streets", "style": "STREETS.DARK" },
    { "id": "OUTDOOR", "label": "Outdoor", "style": "OUTDOOR" },
    { "id": "STREETS", "label": "Streets", "style": "STREETS" },
    { "id": "TOPO", "label": "Topo", "style": "TOPO" },
    { "id": "HYBRID", "label": "Satellite", "style": "HYBRID" }
  ],

  "groups": [
    { "title": "📚 Vector Layers", "layers": ["flood-area", "road_damage", "bridges_damage", "buildings", "calving", "landslide", "affected-wards", "probable-open-spaces", "bridges", "highway", "hydropower", "holding-centers", "ntc-towers", "ncell-towers", "petrol-pump", "banks", "medical", "open-spaces-osm", "lake1", "lake2", "lake3", "hanging_glacier"] },
    { "title": "Mailung Layers", "layers": ["mailung-landmarks", "mailung-substation", "mailung-heli"] },
    { "title": "Damage Photos | Videos", "layers": ["damage-photos", "ground-videos"] }
  ],

  "sections": [
    { "title": "📝 Event Description", "type": "text", "content": "This map presents preliminary flood extent and impact information for Rasuwa, Nepal, following the major ice–rock, debris flow and flood event of 26 August 2026. It visualizes the affected flood extent, damaged roads and bridges, hydropower infrastructure, settlements and other critical facilities along the Bhote Koshi–Trishuli corridor. The map is being actively updated as new satellite observations, field information and damage assessments become available." },
    { "title": "⚠️ Estimated Affected", "type": "list", "content": ["Buildings Affected: 7,210", "Population Affected: 28,840 (Building Based)", "Population Affected: 1,917 (Meta)", "Population Affected: 2,613 (WorldPop)"] },
    { "title": "🗂️ Data Source", "type": "list", "content": ["Administrative Boundary: National Geoportal", "Buildings: OSM, Google, Microsoft", "Flood Extent: UNOSAT", "Ground Videos: Social Media", "Hanging Glaciers: ToolsForEngineers", "Population: Meta, WorldPop", "Satellite Imagery: Vantor", "Towers: Ncell | NTC", "Banks, Bridges, Hydropower, Medical, Petrol Pumps, Road: Self-collected from Google Maps"] },
    { "title": "👥 Team Member", "type": "list", "content": ["Kushal KC", "Alison Shilpakar", "Sujan Tyata", "Risab Shrestha"] }
  ],

