  "layers": [
    {
      "id": "affected-wards", "label": "Affected Local Levels / Wards", "visible": true,
      "source": { "url": "vector/affected_GaPaNaPa.geojson", "promoteId": "OBJECTID" },
      "legend": { "type": "box", "color": "#b75d4966" },
      "render": [
        { "type": "fill", "paint": {
            "fill-color": ["interpolate", ["linear"], ["coalesce", ["to-number", ["get", "Affected_pop"]], 0], 0, "#fee8c820", 500, "#fdbb8420", 1500, "#e34a3320", 3000, "#b3000020"],
            "fill-opacity": ["case", ["boolean", ["feature-state", "hover"], false], 0.55, 0.25] } },
        { "type": "line", "geometry": "polygon", "paint": {
            "line-color": ["case", ["boolean", ["feature-state", "hover"], false], "#edd680", "#8f2d20"],
            "line-width": ["case", ["boolean", ["feature-state", "hover"], false], 2.5, 1] } }
      ],
      "hover": { "state": true, "delay": 500, "className": "ward-hover-popup",
        "template": "<div style='font-size:12px;line-height:1.5;min-width:190px'><div style='font-size:16px;font-weight:700;margin-bottom:3px'>{GaPa_NaPa} ({Type_GN})</div><div style='font-size:14px'><b>District:</b> {DISTRICT}</div><div><b>Ward:</b> {NEW_WARD_N}</div><div><b>Affected population:</b> {Affected_pop|num}</div><div><b>Affected buildings:</b> {geohash_count|num}</div></div>" }
